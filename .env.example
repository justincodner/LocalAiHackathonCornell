# Copy to .env (git-ignored). Every variable Beacon reads, with its default.
BEACON_HELPER_URL=http://127.0.0.1:8765
BEACON_LLM_URL=http://127.0.0.1:8080/v1
BEACON_LLM_QUESTION_URL=          # Brain: e.g. http://127.0.0.1:8082/v1 (Bonsai 4B) for questions; empty = one model
BEACON_LLM_QUESTION_TIMEOUT_S=8   # Brain: one attempt on the question model, then the fast model answers
BEACON_TTS=system                 # system | ttskit (ttskit renders at ~0.4-0.8x real time on the M1, so it only gets very short phrases)
BEACON_STT_MODEL=tiny.en          # large-v3-v20240930_626MB is more accurate but ~1.2 s/utterance and 2+ min load on the M1
BEACON_MODELS_DIR=models          # Helper: root holding whisperkit-coreml/ and ttskit/
BEACON_PTT_KEY=right_option       # right_option | right_command | right_control | fn
BEACON_DEV_LAN=0                  # 1 = listen on LAN (requires BEACON_TOKEN); never for the demo
BEACON_BROWSER_DOM=0              # Mac Helper: opt in to DOM extraction via browser Apple Events
BEACON_TOKEN=
BEACON_MAX_STEPS=8
BEACON_TASK_TIMEOUT_S=45
BEACON_LLM_TIMEOUT_S=12
BEACON_SETTLE_MS=400
BEACON_REPLY_TIMEOUT_S=15
BEACON_SNAPSHOT_MAX_ELEMENTS=120  # Brain: elements per snapshot; lower it if the M1 misses 2.5 s (docs/bench.md)
BEACON_PREWARM=1                  # Brain: cache system prompt + tools at start-up
BEACON_THINKING_FILLER_MS=1500    # Brain: say "One moment." if the model is still thinking
BEACON_PROMPT_PATH=brain/prompts/system_v3.txt
BEACON_TEMPERATURE=0.2
